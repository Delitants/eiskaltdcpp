+	static std::int64_t selected_recheck_payload_bytes(file_storage const& fs, piece_index_t const piece)
+	{
+		std::int64_t bytes = 0;
+		for (auto const& slice : fs.map_block(piece, 0, fs.piece_size(piece)))
+			if (!fs.pad_file_at(slice.file_index)) bytes += slice.size;
+		return bytes;
+	}
 
+	selected_recheck_status torrent::query_selected_recheck(std::uint64_t const token) const
+	{
+		if (token == m_selected_status.token) return m_selected_status;
+		selected_recheck_status ret;
+		ret.token = token;
+		ret.phase = selected_recheck_phase::failed;
+		ret.error = make_error_code(boost::system::errc::invalid_argument);
+		return ret;
+	}
+
+	void torrent::prepare_selected_recheck(std::uint64_t const token)
+	{
+		if (m_selected_active) return;
+		m_selected_status = {};
+		m_selected_status.token = token;
+		if (!token || !valid_metadata() || !m_files_checked || !m_storage
+			|| m_abort || m_state == torrent_status::checking_files
+			|| m_state == torrent_status::checking_resume_data || m_outstanding_file_priority)
+		{
+			m_selected_status.phase = selected_recheck_phase::failed;
+			m_selected_status.error = make_error_code(boost::system::errc::operation_not_permitted);
+			return;
+		}
+		m_selected_auto_managed = m_auto_managed;
+		auto_managed(false);
+		m_selected_active = true;
+		m_selected_cancel = false;
+		m_selected_inflight = false;
+		m_selected_cursor = 0;
+		m_selected_pieces.clear();
+		m_selected_status.phase = selected_recheck_phase::preparing;
+		pause();
+		disconnect_all(errors::torrent_paused, operation_t::bittorrent);
+		stop_announcing();
+		// A per-storage fence drains cached writes before client journal admission.
+		m_ses.disk_thread().async_stop_torrent(m_storage, [self = shared_from_this(), token] {
+			if (self->m_abort || !self->m_selected_active || self->m_selected_status.token != token) return;
+			self->m_selected_status.phase = self->m_selected_cancel
+				? selected_recheck_phase::canceled : selected_recheck_phase::quiesced;
+		});
+		m_ses.deferred_submit_jobs();
+	}
+
+	void torrent::start_selected_recheck(selected_recheck_request request)
+	{
+		if (!m_selected_active || request.token != m_selected_status.token) return;
+		if (m_selected_status.phase != selected_recheck_phase::quiesced) return;
+		std::sort(request.pieces.begin(), request.pieces.end());
+		request.pieces.erase(std::unique(request.pieces.begin(),request.pieces.end()),request.pieces.end());
+		for (auto const p : request.pieces)
+			if (p < piece_index_t(0) || p >= m_torrent_file->end_piece())
+			{
+				m_selected_status.phase = selected_recheck_phase::failed;
+				m_selected_status.error = make_error_code(boost::system::errc::invalid_argument);
+				return;
+			}
+		m_selected_pieces = std::move(request.pieces);
+		leave_seed_mode(seed_mode_t::skip_checking);
+		need_picker(true);
+		set_have_all(false);
+		for (auto const p : m_selected_pieces)
+		{
+			bool const had_piece = m_picker->have_piece(p);
+			m_picker->we_dont_have(p);
+			if (had_piece) inc_stats_counter(counters::num_have_pieces, -1);
+			m_selected_status.total_bytes += selected_recheck_payload_bytes(torrent_file().layout(), p);
+		}
+		m_file_progress.clear();
+		m_file_progress.init(*m_picker, m_torrent_file->layout());
+		set_need_save_resume(torrent_handle::if_download_progress);
+		update_gauge();
+		update_state_timers();
+		set_state(torrent_status::checking_files);
+		m_selected_status.phase = selected_recheck_phase::progress;
+		selected_recheck_next();
+	}
+
+	void torrent::selected_recheck_next()
+	{
+		if (m_abort || !m_selected_active || m_selected_inflight) return;
+		if (m_selected_cancel || m_selected_cursor == m_selected_pieces.size())
+		{
+			m_selected_status.unavailable.insert(m_selected_status.unavailable.end(),
+				m_selected_pieces.begin() + std::ptrdiff_t(m_selected_cursor), m_selected_pieces.end());
+			m_selected_cursor = m_selected_pieces.size();
+			m_selected_status.phase = m_selected_cancel
+				? selected_recheck_phase::canceled : m_selected_status.error
+				? selected_recheck_phase::failed : selected_recheck_phase::complete;
+			state_updated();
+			return;
+		}
+		auto const piece = m_selected_pieces[m_selected_cursor];
+		auto const token = m_selected_status.token;
+		m_selected_inflight = true;
+		// Flush per-piece caches/partial-block state before a fresh disk read.
+		m_ses.disk_thread().async_clear_piece(m_storage, piece,
+			[self = shared_from_this(), token](piece_index_t p) {
+				if (self->m_abort) return;
+				if (self->m_selected_cancel) { self->m_selected_inflight = false; self->selected_recheck_next(); return; }
+				auto flags = disk_interface::volatile_read;
+				if (self->torrent_file().info_hashes().has_v1()) flags |= disk_interface::v1_hash;
+				aux::vector<sha256_hash> hashes;
+				if (self->torrent_file().info_hashes().has_v2())
+					hashes.resize(self->torrent_file().layout().blocks_in_piece2(p));
+				span<sha256_hash> v2(hashes);
+				self->m_ses.disk_thread().async_hash(self->m_storage,p,v2,flags,
+					[self,token,hashes = std::move(hashes)](piece_index_t i,sha1_hash const& h,storage_error const& e) mutable {
+						self->selected_recheck_hashed(token,std::move(hashes),i,h,e);
+					});
+				self->m_ses.deferred_submit_jobs();
+			});
+		m_ses.deferred_submit_jobs();
+	}
+
+	void torrent::selected_recheck_hashed(std::uint64_t const token, aux::vector<sha256_hash> hashes,
+		piece_index_t const piece, sha1_hash const& hash, storage_error const& error)
+	{
+		if (m_abort || !m_selected_active || token != m_selected_status.token) return;
+		m_selected_inflight = false;
+		++m_selected_cursor;
+		m_selected_status.checked_bytes += selected_recheck_payload_bytes(torrent_file().layout(), piece);
+		bool failed = bool(error);
+		bool known = true;
+		if (error && error.ec != boost::system::errc::no_such_file_or_directory
+			&& error.ec != boost::asio::error::eof && error.ec != errors::file_too_short)
+		{
+			m_selected_status.error = error.ec;
+			known = false;
+		}
+		if (!error && torrent_file().info_hashes().has_v1())
+			failed = hash != torrent_file().hash_for_piece(piece);
+		if (!error && torrent_file().info_hashes().has_v2())
+		{
+			need_hash_picker();
+			auto const& fs = torrent_file().layout();
+			auto const file = fs.file_index_at_piece(piece);
+			int const leaves = merkle_num_leafs(fs.file_num_blocks(file));
+			int const piece_leaves = std::min(leaves,torrent_file().blocks_per_piece());
+			int const layer_size = std::max(1,leaves / piece_leaves);
+			int const file_piece = int((std::int64_t(static_cast<int>(piece)) * fs.piece_length()
+				- fs.file_offset(file)) / fs.piece_length());
+			int const node = merkle_first_leaf(layer_size) + file_piece;
+			auto const& tree = m_merkle_trees[file];
+			if (!tree.has_node(node)) known = false;
+			else
+			{
+				hashes.resize(piece_leaves);
+				failed |= !tree.compare_node(node,merkle_root(hashes));
+			}
+		}
+		if (failed && known) m_selected_status.failed.push_back(piece);
+		else if (!known) m_selected_status.unavailable.push_back(piece);
+		else
+		{
+			m_picker->piece_flushed(piece);
+			we_have(piece);
+			m_selected_status.passed.push_back(piece);
+		}
+		set_need_save_resume(torrent_handle::if_download_progress);
+		update_gauge();
+		state_updated();
+		selected_recheck_next();
+	}
+
+	void torrent::cancel_selected_recheck(std::uint64_t const token)
+	{
+		if (!m_selected_active || token != m_selected_status.token) return;
+		if (m_selected_status.phase == selected_recheck_phase::complete
+			|| m_selected_status.phase == selected_recheck_phase::failed) return;
+		m_selected_cancel = true;
+		if (m_selected_status.phase == selected_recheck_phase::preparing) return;
+		selected_recheck_next();
+	}
+
+	void torrent::finish_selected_recheck(std::uint64_t const token, bool const resume_network)
+	{
+		if (!m_selected_active || token != m_selected_status.token || m_selected_inflight) return;
+		auto const phase = m_selected_status.phase;
+		if (phase != selected_recheck_phase::complete && phase != selected_recheck_phase::canceled
+			&& phase != selected_recheck_phase::failed) return;
+		m_selected_active = false;
+		if (m_state == torrent_status::checking_files) files_checked();
+		if (resume_network && !m_selected_status.error)
+		{
+			auto_managed(m_selected_auto_managed);
+			resume();
+		}
+	}
