+enum class selected_recheck_phase { idle, preparing, quiesced, progress, complete, canceled, failed };
+struct selected_recheck_request {
+    std::uint64_t token = 0;
+    std::vector<piece_index_t> pieces;
+};
+struct selected_recheck_status {
+    std::uint64_t token = 0;
+    selected_recheck_phase phase = selected_recheck_phase::idle;
+    std::vector<piece_index_t> passed, failed, unavailable;
+    std::int64_t checked_bytes = 0, total_bytes = 0;
+    error_code error;
+};
+TORRENT_EXPORT int eiskalt_selected_recheck_abi();
+// Worker-thread API. Preparation drains this torrent's writes and inhibits peers.
+// Start requires quiesced state and a durable client recovery record. Results
+// stay network-paused until the client persists resume data and calls finish.
+TORRENT_EXPORT void prepare_selected_recheck(torrent_handle, std::uint64_t);
+TORRENT_EXPORT void start_selected_recheck(torrent_handle, selected_recheck_request);
+TORRENT_EXPORT void cancel_selected_recheck(torrent_handle, std::uint64_t);
+TORRENT_EXPORT void finish_selected_recheck(torrent_handle, std::uint64_t, bool resume_network);
+TORRENT_EXPORT selected_recheck_status query_selected_recheck(torrent_handle, std::uint64_t);
+}
