#: ../ShareManager.cpp:526
msgid "Cannot revoke the saved DC++ hash cache. Check profile folder permissions before restarting."
msgstr "Nie można unieważnić zapisanej pamięci podręcznej skrótów DC++. Przed ponownym uruchomieniem sprawdź uprawnienia do folderu profilu."

msgid "Error rechecking %1%: %2%"
msgstr "Błąd ponownego sprawdzania %1%: %2%"

msgid "File size changed while hashing"
msgstr "Rozmiar pliku zmienił się podczas haszowania"

msgid "Hash data storage failed; restart before adding new hashes"
msgstr "Awaria magazynu danych skrótów; uruchom program ponownie przed dodaniem nowych skrótów"

