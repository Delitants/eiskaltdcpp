# A target-level preflight, not a timestamp dependency: a stale link must not
# survive a changed plist. Only this target's owned build executable is removed.
if(NOT IS_DIRECTORY "${BUILD_ROOT}" OR NOT GENERATION MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Bundle metadata gate requires an existing owned build root and canonical generation")
endif()
file(REAL_PATH "${BUILD_ROOT}" _metadata_build_root)
foreach(_metadata_path IN ITEMS "${EXECUTABLE}" "${RECEIPT}")
    # A first build may have no executable/receipt yet. Resolve its existing
    # ancestor, including parent symlinks, without REAL_PATH's missing-file warning.
    set(_metadata_ancestor "${_metadata_path}")
    set(_metadata_suffix "")
    while(NOT EXISTS "${_metadata_ancestor}")
        if(IS_SYMLINK "${_metadata_ancestor}")
            message(FATAL_ERROR "Bundle metadata gate refuses a dangling symlink in its owned build root")
        endif()
        get_filename_component(_metadata_name "${_metadata_ancestor}" NAME)
        get_filename_component(_metadata_parent "${_metadata_ancestor}" DIRECTORY)
        if(_metadata_parent STREQUAL _metadata_ancestor)
            message(FATAL_ERROR "Bundle metadata gate requires an existing owned build root")
        endif()
        set(_metadata_suffix "/${_metadata_name}${_metadata_suffix}")
        set(_metadata_ancestor "${_metadata_parent}")
    endwhile()
    file(REAL_PATH "${_metadata_ancestor}" _metadata_real_ancestor)
    get_filename_component(_metadata_real_path "${_metadata_real_ancestor}${_metadata_suffix}" ABSOLUTE)
    string(FIND "${_metadata_real_path}" "${_metadata_build_root}/" _metadata_inside)
    if(NOT _metadata_inside EQUAL 0 OR IS_SYMLINK "${_metadata_path}")
        message(FATAL_ERROR "Bundle metadata gate refuses a path outside its owned build root or a symlink")
    endif()
endforeach()
if(RECORD)
    if(NOT EXISTS "${EXECUTABLE}" OR IS_DIRECTORY "${EXECUTABLE}")
        message(FATAL_ERROR "Bundle metadata gate cannot record an unlinked executable")
    endif()
    file(WRITE "${RECEIPT}" "${GENERATION}\n")
    return()
endif()
set(_metadata_linked_generation "")
if(EXISTS "${RECEIPT}")
    file(READ "${RECEIPT}" _metadata_linked_generation)
endif()
if(NOT _metadata_linked_generation STREQUAL "${GENERATION}\n")
    file(REMOVE "${EXECUTABLE}")
endif()
