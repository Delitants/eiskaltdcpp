include_guard(GLOBAL)
set(_EISKALT_OPENSSL_HEADERS_MODULE "${CMAKE_CURRENT_LIST_FILE}")

function(_eiskalt_stage_openssl_headers output include_root)
    get_filename_component(_include_root "${include_root}" REALPATH)
    get_filename_component(_source "${include_root}/openssl" REALPATH)
    file(RELATIVE_PATH _namespace "${_include_root}" "${_source}")
    if(_namespace MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_namespace}")
        message(FATAL_ERROR "Escaping selected OpenSSL directory: ${include_root}/openssl")
    endif()
    if(NOT IS_DIRECTORY "${_source}")
        message(FATAL_ERROR "Missing selected OpenSSL header directory: ${include_root}/openssl")
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE AND NOT CMAKE_VERSION VERSION_LESS 3.12)
        file(GLOB _headers CONFIGURE_DEPENDS "${_source}/*.h")
    else()
        file(GLOB _headers "${_source}/*.h")
    endif()
    set(_names)
    foreach(_header IN LISTS _headers)
        get_filename_component(_name "${_header}" NAME)
        get_filename_component(_resolved "${_header}" REALPATH)
        file(RELATIVE_PATH _relative "${_source}" "${_resolved}")
        if(_relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_relative}" OR IS_DIRECTORY "${_header}")
            message(FATAL_ERROR "Escaping selected OpenSSL header: ${_header}")
        endif()
        list(APPEND _names "${_name}")
    endforeach()
    foreach(_required ssl.h crypto.h opensslv.h opensslconf.h)
        if(NOT _required IN_LIST _names)
            message(FATAL_ERROR "Missing selected OpenSSL header ${_required}; refusing ambient fallback")
        endif()
    endforeach()
    foreach(_header IN LISTS _headers)
        file(READ "${_header}" _content)
        string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*([<\"]openssl/[^>\"]+\\.h[>\"]|\"[^\"]+\\.h\")" _includes "${_content}")
        foreach(_include IN LISTS _includes)
            string(REGEX REPLACE ".*[<\"](openssl/)?([^>\"]+)[>\"]$" "\\2" _companion "${_include}")
            if(NOT _companion IN_LIST _names)
                message(FATAL_ERROR "Missing selected OpenSSL companion ${_companion}; refusing ambient fallback")
            endif()
        endforeach()
    endforeach()
    file(MAKE_DIRECTORY "${output}")
    file(GLOB _old_headers "${output}/*.h")
    foreach(_old IN LISTS _old_headers)
        get_filename_component(_name "${_old}" NAME)
        if(NOT _name IN_LIST _names)
            file(REMOVE "${_old}")
        endif()
    endforeach()
    set(_origins "")
    foreach(_header IN LISTS _headers)
        get_filename_component(_name "${_header}" NAME)
        configure_file("${_header}" "${output}/${_name}" COPYONLY)
        file(SHA256 "${_header}" _sha256)
        string(APPEND _origins "${_name}\t${_header}\t${_sha256}\n")
    endforeach()
    file(WRITE "${output}/origins.tsv" "${_origins}")
endfunction()

function(eiskalt_isolate_openssl_headers include_root)
    get_filename_component(_source "${include_root}" REALPATH)
    get_filename_component(_namespace "${include_root}/openssl" REALPATH)
    file(RELATIVE_PATH _relative "${_source}" "${_namespace}")
    if(_relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${_relative}")
        # Package-manager include aliases are valid only when both selected
        # libraries resolve to the package exporting that exact namespace.
        foreach(_variable OPENSSL_SSL_LIBRARY OPENSSL_CRYPTO_LIBRARY)
            if(NOT DEFINED ${_variable} OR NOT EXISTS "${${_variable}}")
                message(FATAL_ERROR "Escaping selected OpenSSL directory: ${include_root}/openssl")
            endif()
            get_filename_component(_library "${${_variable}}" REALPATH)
            get_filename_component(_libdir "${_library}" DIRECTORY)
            get_filename_component(_prefix "${_libdir}" DIRECTORY)
            get_filename_component(_expected "${_prefix}/include/openssl" REALPATH)
            if(NOT _namespace STREQUAL _expected)
                message(FATAL_ERROR "Escaping selected OpenSSL directory does not match ${_variable}")
            endif()
        endforeach()
        get_filename_component(_source "${_namespace}" DIRECTORY)
    endif()
    if(TARGET eiskalt-openssl-headers)
        get_target_property(_selected eiskalt-openssl-headers EISKALT_OPENSSL_SOURCE)
        if(NOT _source STREQUAL _selected)
            message(FATAL_ERROR "Conflicting selected OpenSSL header roots")
        endif()
        get_target_property(_root eiskalt-openssl-headers EISKALT_OPENSSL_INCLUDE)
    else()
        set(_root "${CMAKE_CURRENT_BINARY_DIR}/openssl-provider/include")
        _eiskalt_stage_openssl_headers("${_root}/openssl" "${_source}")
        set(_stage "${CMAKE_CURRENT_BINARY_DIR}/openssl-provider/stage.cmake")
        file(WRITE "${_stage}" "cmake_minimum_required(VERSION 3.10)\ninclude([==[${_EISKALT_OPENSSL_HEADERS_MODULE}]==])\n_eiskalt_stage_openssl_headers([==[${_root}/openssl]==] [==[${_source}]==])\n")
        file(GLOB _staged_headers "${_root}/openssl/*.h")
        add_custom_target(eiskalt-openssl-headers ALL
            COMMAND "${CMAKE_COMMAND}" -P "${_stage}"
            BYPRODUCTS ${_staged_headers} "${_root}/openssl/origins.tsv" VERBATIM)
        set_target_properties(eiskalt-openssl-headers PROPERTIES
            EISKALT_OPENSSL_SOURCE "${_source}" EISKALT_OPENSSL_INCLUDE "${_root}")
    endif()
    # A distinct ordinary include root cannot be deduplicated into an imported
    # SYSTEM directory behind the compiler's ambient /usr/local search path.
    include_directories(BEFORE "${_root}")
endfunction()

function(_eiskalt_attach_openssl_headers directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_target_property(_root eiskalt-openssl-headers EISKALT_OPENSSL_INCLUDE)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            target_include_directories("${_target}" BEFORE PRIVATE "${_root}")
            add_dependencies("${_target}" eiskalt-openssl-headers)
        endif()
    endforeach()
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _eiskalt_attach_openssl_headers("${_child}")
    endforeach()
endfunction()

function(eiskalt_attach_openssl_headers)
    if(TARGET eiskalt-openssl-headers)
        _eiskalt_attach_openssl_headers("${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
endfunction()
