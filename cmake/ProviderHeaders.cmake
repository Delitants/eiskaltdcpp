include_guard(GLOBAL)
set(_EISKALT_PROVIDER_HEADERS_MODULE "${CMAKE_CURRENT_LIST_FILE}")

function(_eiskalt_copy_provider_headers output provider pattern required_header)
    file(MAKE_DIRECTORY "${output}")
    file(GLOB _old_headers "${output}/${pattern}")
    set(_copied)
    set(_origins)
    foreach(_directory IN LISTS ARGN)
        if(NOT IS_DIRECTORY "${_directory}")
            continue()
        endif()
        get_filename_component(_directory "${_directory}" ABSOLUTE)
        file(GLOB _headers "${_directory}/${pattern}")
        foreach(_header IN LISTS _headers)
            get_filename_component(_name "${_header}" NAME)
            list(FIND _copied "${_name}" _already_copied)
            if(_already_copied EQUAL -1)
                configure_file("${_header}" "${output}/${_name}" COPYONLY)
                file(SHA256 "${_header}" _sha256)
                string(APPEND _origins "${_name}\t${_header}\t${_sha256}\n")
                list(APPEND _copied "${_name}")
            endif()
        endforeach()
    endforeach()
    foreach(_old_header IN LISTS _old_headers)
        get_filename_component(_old_name "${_old_header}" NAME)
        list(FIND _copied "${_old_name}" _retained)
        if(_retained EQUAL -1)
            file(REMOVE "${_old_header}")
        endif()
    endforeach()
    list(FIND _copied "${required_header}" _required)
    if(_required EQUAL -1)
        message(FATAL_ERROR "Cannot resolve selected ${provider} headers; refusing ambient header fallback")
    endif()
    foreach(_name IN LISTS _copied)
        file(READ "${output}/${_name}" _content)
        string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*[<\"](ares[_a-zA-Z0-9]*|maxminddb[_a-zA-Z0-9]*)\\.h[>\"]" _includes "${_content}")
        foreach(_include IN LISTS _includes)
            string(REGEX REPLACE ".*[<\"]([^>\"]+)[>\"]$" "\\1" _companion "${_include}")
            list(FIND _copied "${_companion}" _companion_index)
            if(_companion_index EQUAL -1)
                message(FATAL_ERROR "Missing selected ${provider} companion ${_companion}; refusing ambient header fallback")
            endif()
        endforeach()
    endforeach()
    file(WRITE "${output}/origins.tsv" "${_origins}")
endfunction()

function(eiskalt_use_provider_headers target cares_target maxmind_include)
    set(_cares_headers)
    set(_pending "${cares_target}")
    set(_visited)
    # Upstream cares_static can be an INTERFACE wrapper around cares.
    while(_pending)
        list(GET _pending 0 _provider)
        list(REMOVE_AT _pending 0)
        list(FIND _visited "${_provider}" _seen)
        if(NOT TARGET "${_provider}" OR NOT _seen EQUAL -1)
            continue()
        endif()
        list(APPEND _visited "${_provider}")
        foreach(_property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
            get_target_property(_directories ${_provider} ${_property})
            if(_directories)
                list(APPEND _cares_headers ${_directories})
            endif()
        endforeach()
        # CMake before 3.18 keeps pkg-config -isystem paths in compile options.
        get_target_property(_options ${_provider} INTERFACE_COMPILE_OPTIONS)
        set(_system_path_next FALSE)
        foreach(_option IN LISTS _options)
            if(_system_path_next)
                list(APPEND _cares_headers "${_option}")
                set(_system_path_next FALSE)
            elseif(_option STREQUAL "-isystem")
                set(_system_path_next TRUE)
            elseif(_option MATCHES "^-isystem(.+)$")
                list(APPEND _cares_headers "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        get_target_property(_links ${_provider} INTERFACE_LINK_LIBRARIES)
        if(_links)
            list(APPEND _pending ${_links})
        endif()
    endwhile()
    set(_base "${CMAKE_CURRENT_BINARY_DIR}/provider-headers/${target}")
    set(_overlay "${_base}/$<CONFIG>")
    # A distinct build-owned directory avoids Clang's -I/-isystem deduplication
    # without changing imported providers or sibling consumers. Copy origins
    # are retained for byte-level readback. Stage before compilation on
    # every build so removed headers cannot leave stale overlay files behind.
    set(_stage "include([==[${_EISKALT_PROVIDER_HEADERS_MODULE}]==])\n")
    string(APPEND _stage "_eiskalt_copy_provider_headers([==[${_overlay}/cares]==] c-ares ares*.h ares.h [==[${_cares_headers}]==])\n")
    set(_provider_headers "${_overlay}/cares")
    if(maxmind_include)
        string(APPEND _stage "_eiskalt_copy_provider_headers([==[${_overlay}/maxmind]==] MaxMind maxminddb*.h maxminddb.h [==[${maxmind_include}]==])\n")
        list(APPEND _provider_headers "${_overlay}/maxmind")
    endif()
    # file(GENERATE) evaluates configuration and semicolon-valued usage
    # requirements without attempting to parse generator expressions ourselves.
    file(GENERATE OUTPUT "${_overlay}/stage.cmake" CONTENT "${_stage}")
    set(_byproduct_base "${_overlay}")
    if(CMAKE_VERSION VERSION_LESS 3.20)
        if(CMAKE_GENERATOR STREQUAL "Ninja Multi-Config")
            message(FATAL_ERROR "Provider header staging with Ninja Multi-Config requires CMake 3.20 or newer")
        endif()
        set(_byproduct_base "${_base}/${CMAKE_CFG_INTDIR}")
        if(NOT CMAKE_CONFIGURATION_TYPES)
            set(_byproduct_base "${_base}/${CMAKE_BUILD_TYPE}")
        endif()
    endif()
    # Declared outputs let Ninja re-evaluate object dependencies after staging,
    # rather than deciding that objects are clean before their headers change.
    set(_byproducts)
    foreach(_header ares.h ares_build.h ares_version.h ares_dns.h ares_nameser.h ares_dns_record.h)
        list(APPEND _byproducts "${_byproduct_base}/cares/${_header}")
    endforeach()
    if(maxmind_include)
        list(APPEND _byproducts "${_byproduct_base}/maxmind/maxminddb.h" "${_byproduct_base}/maxmind/maxminddb_config.h")
    endif()
    add_custom_target(${target}-provider-headers
        COMMAND "${CMAKE_COMMAND}" -P "${_overlay}/stage.cmake"
        BYPRODUCTS ${_byproducts} VERBATIM)
    add_dependencies(${target} ${target}-provider-headers)
    if(NOT CMAKE_CONFIGURATION_TYPES)
        if(NOT "${_cares_headers}" MATCHES "\\$<")
            _eiskalt_copy_provider_headers("${_base}/${CMAKE_BUILD_TYPE}/cares" c-ares "ares*.h" ares.h ${_cares_headers})
        endif()
        if(maxmind_include AND NOT "${maxmind_include}" MATCHES "\\$<")
            _eiskalt_copy_provider_headers("${_base}/${CMAKE_BUILD_TYPE}/maxmind" MaxMind "maxminddb*.h" maxminddb.h "${maxmind_include}")
        endif()
    endif()
    target_include_directories(${target} BEFORE PRIVATE ${_provider_headers})
endfunction()
