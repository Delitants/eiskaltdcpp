{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}",
        "USE_QT6": "ON",
        "USE_GTK3": "OFF",
        "USE_QT_QML": "OFF",
        "USE_QT_SQLITE": "ON",
        "USE_JS": "ON",
        "USE_MINIUPNP": "ON",
        "WITH_DHT": "ON",
        "LUA_SCRIPT": "ON",
        "PERL_REGEX": "ON",
        "USE_IDN2": "ON",
        "USE_ASPELL": "OFF",
        "DBUS_NOTIFY": "OFF",
        "BUILD_TESTS": "OFF",
        "OPENSSL_MSVC": "ON",
        "INSTALL_DEPENDENCIES": "OFF"
      }
    },
    {
      "name": "windows-vs2022-x64",
      "displayName": "Windows 11 / MSVC 2022 x64",
      "description": "Visual Studio 2022 generator for EiskaltDC++ Qt build",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-vs2026-x64",
      "displayName": "Windows 11 / MSVC 2026 x64",
      "description": "Visual Studio 2026 generator for EiskaltDC++ Qt build",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-ninja-multi",
      "displayName": "Windows 11 / Ninja Multi-Config",
      "description": "Ninja Multi-Config build using MSVC tools",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows-vs2022-release",
      "displayName": "Build (VS2022, Release)",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "build-windows-vs2022-relwithdebinfo",
      "displayName": "Build (VS2022, RelWithDebInfo)",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-windows-vs2026-release",
      "displayName": "Build (VS2026, Release)",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "build-windows-vs2026-relwithdebinfo",
      "displayName": "Build (VS2026, RelWithDebInfo)",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-windows-ninja-release",
      "displayName": "Build (Ninja Multi-Config, Release)",
      "configurePreset": "windows-ninja-multi",
      "configuration": "Release"
    }
  ]
}
