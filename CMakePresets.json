{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "macos-release-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
          { "type": "notEquals", "lhs": "$env{DEPS_PREFIX}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{QT_PREFIX}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{COCOA_PLUGIN}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{COCOA_PLUGIN_SHA256}", "rhs": "" }
        ]
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "REPLACE_VERSION": "3.0.0-pre.1",
        "CMAKE_PREFIX_PATH": "$env{QT_PREFIX};$env{DEPS_PREFIX};$env{DEPS_PREFIX}/opt/openssl@3;$env{DEPS_PREFIX}/opt/gettext",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF",
        "CMAKE_BUILD_RPATH": "$env{QT_PREFIX}/lib;$env{DEPS_PREFIX}/lib",
        "EISKALT_MACOS_DEPS_PREFIX": "$env{DEPS_PREFIX}",
        "EISKALT_MACDEPLOYQT_LIBRARY_PATHS": "$env{QT_PREFIX}/lib;$env{DEPS_PREFIX}/lib;$env{DEPS_PREFIX}/opt/webp/lib",
        "EISKALT_QCOCOA_PLUGIN_OVERRIDE": "$env{COCOA_PLUGIN}",
        "EISKALT_QCOCOA_PLUGIN_SHA256": "$env{COCOA_PLUGIN_SHA256}",
        "USE_QT6": "ON",
        "USE_GTK3": "OFF",
        "USE_TORRENT": "ON",
        "WITH_DHT": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-intel",
      "displayName": "macOS 14+ / Intel x86_64 only",
      "description": "Requires matching Intel dependencies and patched Cocoa plugin; see macos/RELEASE.md",
      "inherits": "macos-release-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
        "CMAKE_IGNORE_PREFIX_PATH": "/opt/homebrew;/opt/local"
      }
    },
    {
      "name": "macos-apple-silicon",
      "displayName": "macOS 26+ / Apple Silicon arm64 only",
      "description": "Requires matching ARM64 dependencies and patched Cocoa plugin; see macos/RELEASE.md",
      "inherits": "macos-release-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "CMAKE_IGNORE_PREFIX_PATH": "/usr/local;/opt/local"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{Qt6_DIR}",
        "USE_QT6": "ON",
        "USE_GTK3": "OFF",
        "USE_QT_QML": "OFF",
        "USE_QT_SQLITE": "ON",
        "USE_JS": "ON",
        "USE_MINIUPNP": "ON",
        "WITH_DHT": "ON",
        "LUA_SCRIPT": "ON",
        "PERL_REGEX": "ON",
        "USE_IDN2": "ON",
        "USE_ASPELL": "OFF",
        "DBUS_NOTIFY": "OFF",
        "BUILD_TESTS": "OFF",
        "OPENSSL_MSVC": "ON",
        "INSTALL_DEPENDENCIES": "OFF"
      }
    },
    {
      "name": "windows-vs2022-x64",
      "displayName": "Windows 11 / MSVC 2022 x64",
      "description": "Visual Studio 2022 generator for EiskaltDC++ Qt build",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-vs2026-x64",
      "displayName": "Windows 11 / MSVC 2026 x64",
      "description": "Visual Studio 2026 generator for EiskaltDC++ Qt build",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "windows-ninja-multi",
      "displayName": "Windows 11 / Ninja Multi-Config",
      "description": "Ninja Multi-Config build using MSVC tools",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    {
      "name": "build-macos-intel",
      "configurePreset": "macos-intel",
      "jobs": 2
    },
    {
      "name": "build-macos-apple-silicon",
      "configurePreset": "macos-apple-silicon",
      "jobs": 2
    },
    {
      "name": "build-windows-vs2022-release",
      "displayName": "Build (VS2022, Release)",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "build-windows-vs2022-relwithdebinfo",
      "displayName": "Build (VS2022, RelWithDebInfo)",
      "configurePreset": "windows-vs2022-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-windows-vs2026-release",
      "displayName": "Build (VS2026, Release)",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "build-windows-vs2026-relwithdebinfo",
      "displayName": "Build (VS2026, RelWithDebInfo)",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-windows-ninja-release",
      "displayName": "Build (Ninja Multi-Config, Release)",
      "configurePreset": "windows-ninja-multi",
      "configuration": "Release"
    }
  ]
}
